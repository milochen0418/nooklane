# Every setting here is OPTIONAL.
# With none of them set, Nooklane starts its own open-source LiveKit server
# (https://github.com/livekit/livekit), generates its API key/secret, and
# keeps its spaces in its data directory.

# Admin passcode: unlocks /settings (API key/secret, media IP override,
# restart, log) and Build mode in every space. Whoever makes a space gets
# that space's own build key in their browser, without this.
ADMIN_PASSCODE=

# Where spaces and the LiveKit server's files live.
# Default: ~/Library/Application Support/nooklane (macOS), ~/.local/share/nooklane (Linux).
# NOOKLANE_DATA_DIR=

# IP address browsers send voices, cameras and data to (LiveKit rtc.node_ip).
# Behind re-ddns it comes automatically from EXTERNAL_IP (the Docker host's LAN IP).
# LIVEKIT_NODE_IP=

# Fixed API key/secret, e.g. to share this server with other apps.
# The secret must be at least 32 characters.
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# Ports. In Docker, publish the media ports on the host: TCP 7581 and UDP 7582.
# (Below the other LiveKit apps: audio 7880-7882, video 7980-7982,
# avatar 7780-7782, English 7680-7682.)
# LIVEKIT_PORT=7580
# LIVEKIT_RTC_TCP_PORT=7581
# LIVEKIT_RTC_UDP_PORT=7582

# livekit-server binary. Linux downloads this release from GitHub on first start;
# macOS uses the one on PATH (brew install livekit).
# LIVEKIT_SERVER_BIN=
# LIVEKIT_SERVER_VERSION=1.13.7

# Directory for the LiveKit server's runtime files (default: <data dir>/livekit).
# LIVEKIT_HOME=

# LiveKit URL handed to browsers (default: this app's own backend URL, which relays /rtc).
# LIVEKIT_PUBLIC_URL=
